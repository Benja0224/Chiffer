<%- include("general/header.ejs")%> 
<div class='cipher-box'>
    <span>
        <h3>Morse</h3><button type="button" onclick="setModal('morse')" class="btn btn-primary btn-lg modal-btn" data-toggle="modal" data-target="#infoModal"><i class="glyphicon glyphicon-question-sign"></i></button>
    </span>
        <form>
            <h4>Alternativ</h4>
            <div class="radio" id="optMorse">
                <label><input type="radio" name="optradio" checked="checked">. - , /</label>
                <label><input type="radio" name="optradio">&bull; &ndash; _ |</label>
                <label><input type="radio" name="optradio">k l , _</label>
            </div>
            <h4>Text</h4>
            <textarea rows="1" id="textMorse" >a</textarea>
        </form> 
        <span class="button-box">
        <button onClick="encodeMorse()" id="#">encode</button>
        <button onClick="decodeMorse()" id="#" disabled>decode</button>  
        </span>
        <div id="resultMorse" ></div>
</div>
<%- include("general/footer.ejs")%> 